<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- Background Task Listener for Automated Emails -->
    <listener>
        <listener-class>ExpiryScheduler</listener-class>
    </listener>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- New Single-Step Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/registerAccount</url-pattern>
    </servlet-mapping>

    <!-- Add Medicine Servlet -->
    <servlet>
        <servlet-name>AddMedicineServlet</servlet-name>
        <servlet-class>AddMedicineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddMedicineServlet</servlet-name>
        <url-pattern>/addMedicine</url-pattern>
    </servlet-mapping>

    <!-- Medicines Servlet -->
    <servlet>
        <servlet-name>MedicinesServlet</servlet-name>
        <servlet-class>MedicinesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MedicinesServlet</servlet-name>
        <url-pattern>/medicines</url-pattern>
    </servlet-mapping>

    <!-- Delete Medicine Servlet -->
    <servlet>
        <servlet-name>DeleteMedicineServlet</servlet-name>
        <servlet-class>DeleteMedicineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteMedicineServlet</servlet-name>
        <url-pattern>/deleteMedicine</url-pattern>
    </servlet-mapping>

    <!-- Profile Servlet -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Inventory Servlet -->
    <servlet>
        <servlet-name>InventoryServlet</servlet-name>
        <servlet-class>InventoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InventoryServlet</servlet-name>
        <url-pattern>/inventory</url-pattern>
    </servlet-mapping>

    <!-- Expiry Notification Servlet -->
    <servlet>
        <servlet-name>ExpiryNotification</servlet-name>
        <servlet-class>ExpiryNotification</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExpiryNotification</servlet-name>
        <url-pattern>/expiry</url-pattern>
    </servlet-mapping>

    <!-- Test Mail Servlet -->
    <servlet>
        <servlet-name>TestMailServlet</servlet-name>
        <servlet-class>TestMailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestMailServlet</servlet-name>
        <url-pattern>/TestMailServlet</url-pattern>
    </servlet-mapping>

</web-app>